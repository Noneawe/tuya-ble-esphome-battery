# Copy this file to secrets.yaml (same directory as your ESPHome YAML) and
# fill in your own values. secrets.yaml is git-ignored — never commit it.
#
# See docs/getting-the-local-key.md for how to actually obtain these values.

tuya_mac_address: "AA:BB:CC:DD:EE:FF"
tuya_device_id: "your_tuya_device_id"
tuya_uuid: "your_tuya_device_uuid"
tuya_local_key: "your16charlocalkey"

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

ota_password: "choose-a-strong-ota-password"
api_encryption_key: "choose-a-32-byte-base64-key-or-run-esphome-to-generate-one"
